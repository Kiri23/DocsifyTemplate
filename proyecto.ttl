proyecto:docsify-template schema:softwareRequirements vocabulario.preact:hook .
# from: packages/docs-engine/src/components/api-endpoint.js:23 return html`
proyecto:docsify-template schema:softwareRequirements vocabulario.preact:htm .
# from: packages/docs-engine/src/adapters/astro/rehype-components.js:51 const htmlString = renderToString(h(Component, { data }));
proyecto:docsify-template schema:softwareRequirements vocabulario.preact:render-a-string .
